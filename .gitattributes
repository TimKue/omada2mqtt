# Keep line endings deterministic across platforms: LF in the repo.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
.env*  text eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries.
*.exe  binary
