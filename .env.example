# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
OMADA_BASE_URL=https://192.168.178.2:8043
OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Local controllers use a self-signed certificate:
OMADA_INSECURE=true

# MQTT broker (Mosquitto add-on in Home Assistant)
MQTT_HOST=192.168.178.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=omada2mqtt

# OPNsense (only needed for the DNS-naming sync). API key/secret from
# System > Access > Users > (user) > API keys. Uses a self-signed cert by default.
OPNSENSE_URL=https://192.168.178.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_INSECURE=true
